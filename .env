# =========================================================
# ARGUS PRODUCTION CONFIG
# Last updated: 2026-03-11
# All strategy filters ENABLED. This is the paper trading config.
# For Gate A smoke tests restore: copy .env.smoke_test -> .env
# =========================================================

# =========================================================
# Runtime mode
# =========================================================
DRY_RUN=false
BACKTEST_MODE=false
QUIET_MODE=false

# =========================================================
# HTTP / Resilience
# =========================================================
HTTP_TIMEOUT=15
MAX_FAIL_BACKOFF_SECONDS=60
STALE_TICK_SECONDS=20

# =========================================================
# Product / Candle
# =========================================================
PRODUCT_ID=ETH-USD
CANDLE_SECONDS=60
CANDLE_SECONDS_5M=300
CANDLE_SECONDS_1H=3600

# =========================================================
# Adaptive polling
# =========================================================
POLL_SLOW_SECONDS=15
POLL_MED_SECONDS=5
POLL_FAST_SECONDS=2
POLL_TURBO_SECONDS=1

# =========================================================
# Indicators (candle-close)
# =========================================================
MA_FAST=5
MA_SLOW=20
MA_TREND_50=50
MA_TREND_200=200

# =========================================================
# Entry quality gates
# =========================================================
MIN_SPREAD_BPS=1
MA200_BAND_PCT=0.005
COOLDOWN_SECONDS=300
TREND_INVALIDATION_CLOSES=3
MIN_HOLD_SECONDS=180

# =========================================================
# Exit model
# =========================================================
TAKE_PROFIT_PCT=0.03
TRAIL_STOP_PCT=0.015
STOP_LOSS_PCT=0.02

# =========================================================
# Adaptive distance thresholds
# =========================================================
NEAR_ENTRY_PCT=0.005
NEAR_EXIT_PCT=0.005
TURBO_PCT=0.002

# =========================================================
# Ops switches (ABSOLUTE PATHS — CWD-invariant)
# =========================================================
KILL_SWITCH_FILE=C:\Argus\repo\ops\KILL_SWITCH.txt
PAUSE_FILE=C:\Argus\repo\ops\PAUSE.txt

# =========================================================
# Notifications
# =========================================================
DISCORD_WEBHOOK_URL=

# =========================================================
# Virtual ledger / execution sizing
# =========================================================
START_CASH_USD=500
ACCOUNT_CURRENCY=USD

MAX_TRADE_FRACTION=0.25
MAX_TOTAL_EXPOSURE=0.50
MIN_ORDER_USD=10
USD_PER_TRADE=25

# =========================================================
# Volatility-based sizing (Phase 4A)
# Enabled — sizes positions relative to ATR volatility
# =========================================================
USE_VOL_SIZING=true
VOL_WINDOW=60
VOL_LOOKBACK=60
RISK_PER_TRADE_USD=5
VOL_STOP_MULT=2.0
VOL_FALLBACK_TO_CAPS=true

# =========================================================
# Risk guardrails
# =========================================================
DAILY_MAX_LOSS_USD=20
MAX_TRADES_PER_DAY=8
COOLDOWN_AFTER_LOSS_SECONDS=600
CLEAR_LOCKOUT_ON_DAY_RESET=true

# =========================================================
# Reporting / tracker
# =========================================================
TRACK_MFE_MAE=true
SUMMARY_EVERY_SECONDS=60
TRACK_HOLD_REASONS=true
HOLD_BUMP_EVERY_SECONDS=300
TRADE_TRACKER_FILE=trade_tracker.txt
TRADE_TRACKER_ENABLED=true
DISABLE_TRADE_TRACKER_IN_BACKTEST=true
USE_SHOULD_EVENTS=false

# =========================================================
# FORCE TEST — DISABLED for production
# Restore .env.smoke_test for Gate A harness runs
# =========================================================
FORCE_TEST_BUY=false
FORCE_TEST_SELL=false
FORCE_TEST_ONLY_ONCE=true
FORCE_TEST_TAG=

# =========================================================
# Phase 3.5 — Multi-Timeframe Confluence (ENABLED)
# Requires 1m signal + trend_ok + HTF confirmation
# =========================================================
REQUIRE_CONFLUENCE=true
CONFLUENCE_W_1M=0.2
CONFLUENCE_W_5M=0.3
CONFLUENCE_W_1H=0.5

CONFLUENCE_WATCH_SCORE=55
CONFLUENCE_TRADE_SCORE=80
CONFLUENCE_MIN_SCORE=80
CONFLUENCE_SIZE_MULT_WHEN_NOT_TRADE=0

CONFLUENCE_REQUIRE_1M_SIGNAL=true
CONFLUENCE_REQUIRE_1M_TRENDOK=true
CONFLUENCE_REQUIRE_HTF_CONFIRM=true
CONFLUENCE_HTF_MIN_SCORE=55

CONFLUENCE_ALIGNMENT_BONUS=5
CONFLUENCE_CONFLICT_PENALTY=10
CONFLUENCE_IGNORE_MISSING_TFS=false

# =========================================================
# Phase 4B — Regime detection (ENABLED)
# =========================================================
REGIME_LOOKBACK=50
REGIME_VOL_HIGH=0.01
REGIME_VOL_LOW=0.003
REGIME_TREND_SLOPE_MIN=0.0003
REGIME_MA_SPREAD_MIN=0.0015
REGIME_MIN_GATE_SCORE=0
REGIME_ENTRY_BLOCK_LIST=TREND_DOWN,RANGE

# =========================================================
# Phase 4C — Adaptive confluence (ENABLED)
# Boosts score in trends, penalises chop
# =========================================================
USE_ADAPTIVE_CONFLUENCE=true

AC_BONUS_TREND_UP=5
AC_BONUS_TREND_DOWN=-15

AC_PENALTY_RANGE=15
AC_PENALTY_VOLATILE_RANGE=20

AC_TRADE_SHIFT_RANGE=5
AC_TRADE_SHIFT_VOLATILE_RANGE=10
AC_WATCH_SHIFT_RANGE=3
AC_WATCH_SHIFT_VOLATILE_RANGE=5

AC_MIN_TREND_STRENGTH_FOR_TRADE=0

# =========================================================
# Phase 5A — Market Structure (ENABLED — soft scoring only)
# Hard blocks disabled until data confirms their value
# =========================================================
USE_STRUCTURE=true

STRUCT_BONUS_BREAK_RETEST=8
STRUCT_BONUS_NEAR_SUPPORT=3
STRUCT_PENALTY_REJECT_AT_RES=8
STRUCT_PENALTY_FAILED_RETEST=10

STRUCT_BLOCK_LONG_ON_REJECT_RES=false
STRUCT_BLOCK_LONG_BELOW_SUPPORT=false
STRUCT_BLOCK_LONG_ON_FAILED_RETEST=false
STRUCT_BLOCK_LONG_WHEN_BREAKING_DOWN=false

STRUCT_GATE_BUMP_ENABLED=true
STRUCT_GATE_BUMP_MAX_POINTS=6

# =========================================================
# Phase 5B — Liquidity Filters (ENABLED — penalise mode)
# Hard BLOCK mode disabled until spread/vol baselines confirmed
# =========================================================
USE_LIQUIDITY_FILTERS=true
USE_LIQUIDITY=true

LIQ_MODE=PENALIZE
LIQ_MAX_SPREAD_BPS=20
LIQ_PENALTY_POINTS=10
# LIQ_MIN_VOL_USD_1M: DISABLED (was 50000 USD but vol_1m is in ETH — unit mismatch).
# Use LIQ_MIN_VOL_UNITS_1M=25 instead (25 ETH/min ≈ $50k at $2000).
LIQ_MIN_VOL_USD_1M=0
LIQ_MIN_VOL_UNITS_1M=25
LIQ_MIN_VOL_MULT=0.5
LIQ_VOL_BASELINE_WINDOW=60
LIQ_ATR_WINDOW=14
LIQ_ATR_NORM_MIN=0
LIQ_ATR_NORM_MAX=0

LIQ_BLOCK_ON_MISSING_SPREAD=false
LIQ_BLOCK_ON_MISSING_VOLUME=false
LIQ_BLOCK_ON_MISSING_ATR_NORM=false

# =========================================================
# Phase 5C — Session modifiers (ENABLED)
# NY overlap and NY session get score bonus + full risk
# Asian off-hours reduce risk multiplier
# =========================================================
USE_SESSION_MODIFIERS=true

SESSION_ASIA_BONUS=0
SESSION_LONDON_BONUS=3
SESSION_NY_BONUS=5
SESSION_OVERLAP_BONUS=8

SESSION_ASIA_RISK_MULT=0.7
SESSION_LONDON_RISK_MULT=1.0
SESSION_NY_RISK_MULT=1.0
SESSION_OVERLAP_RISK_MULT=1.0
SESSION_OFF_RISK_MULT=0.5

# =========================================================
# Fees and slippage (realistic paper estimates)
# Coinbase Advanced Trade taker ~5-6bps, slippage ~3-5bps
# =========================================================
FEE_BPS=6
SLIPPAGE_BPS=5
SHADOW_NOTIONAL_USD=1000

# =========================================================
# Phase 8 — Execution runtime
# =========================================================
EXECUTION_MODE=ADAPTER
EXECUTION_ADAPTER=PAPER

PAPER_FEE_BPS=6
PAPER_SLIPPAGE_BPS=5
PAPER_QTY_PRECISION=0.00000001
PAPER_PX_PRECISION=0.01

EXECUTION_RECONCILE_ON_STARTUP=true
EXECUTION_HEARTBEAT_REQUIRED=false
EXECUTION_POLL_FILLS_EVERY_SECONDS=1

# =========================================================
# Execution guardrails
# =========================================================
MAX_ENTRY_SPREAD_BPS=25
MAX_POSITION_QTY_PER_SYMBOL=0
MAX_POSITION_USD_PER_SYMBOL=150
MAX_PORTFOLIO_EXPOSURE_USD=150
MAX_MARKET_DATA_AGE_SECONDS=60

# =========================================================
# Phase 16 — Ops infrastructure
# =========================================================
RUNTIME_MODE_FILE=C:\Argus\repo\ops\runtime_mode.json
RUNTIME_MODE_GATING_ENABLED=true
HEALTH_FEED_STALE_SECONDS=60
HEALTH_FILL_LATENCY_SECONDS=30
HEALTH_CONSECUTIVE_LOSSES=5
HEALTH_SLIPPAGE_ANOMALY_BPS=50

# =========================================================
# Phase 18 — Dynamic Trendlines (1h)
# =========================================================
# Set to true to enable 1h trendline detection + scoring overlay
USE_TRENDLINES=false
TL_SWING_LEFT=3
TL_SWING_RIGHT=3
TL_NEAR_PCT=0.005
TL_BREAK_PCT=0.003
TL_MAX_PIVOT_HISTORY=20
TL_MIN_PIVOTS=2
TL_MAX_SLOPE_AGE_BARS=60
TL_BONUS_NEAR_SUPPORT=5
TL_PENALTY_NEAR_RESIST=8
TL_BONUS_BROKE_ABOVE_RESIST=12
TL_PENALTY_BROKE_BELOW_SUPPORT=15
TL_BLOCK_LONG_NEAR_RESIST=false
TL_BLOCK_LONG_BROKE_BELOW_SUPPORT=true
TL_PENALTY_RESIST_SLOPE_NEG=0
