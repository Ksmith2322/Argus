# .env.btc — BTC-USD per-coin overrides (layered on base .env)
# Backtests show BTC needs looser gating than ETH:
# 90d BTC score80/gate30: PF=1.131, WR=41.2%, 51 trades, DD=0.39%
# 90d BTC score88/gate38: PF=1.015, WR=39.3%, 28 trades (too few)

PRODUCT_ID=BTC-USD
START_CASH_USD=500
MAX_POSITION_USD_PER_SYMBOL=150
MAX_PORTFOLIO_EXPOSURE_USD=150

# BTC-specific gating (looser than ETH's 88/0.38)
CONFLUENCE_MIN_SCORE=80
ML_GOVERNOR_THRESHOLD=0.30