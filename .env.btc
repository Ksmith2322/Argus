# .env.btc — BTC-USD per-coin overrides (layered on base .env)
# Backtests show BTC needs looser gating than ETH:
# 90d BTC score80/gate30: PF=1.131, WR=41.2%, 51 trades, DD=0.39%
# 90d BTC score88/gate38: PF=1.015, WR=39.3%, 28 trades (too few)
# 2026-03-17 sweep: btc_tp025 PF=2.344 (vs 1.797 at tp015), gov35 PF=1.585 (vs ~1.3 at gov30)

PRODUCT_ID=BTC-USD
START_CASH_USD=500
MAX_POSITION_USD_PER_SYMBOL=150
MAX_PORTFOLIO_EXPOSURE_USD=150

# BTC-specific gating (looser than ETH's 88/0.38)
CONFLUENCE_MIN_SCORE=80
ML_GOVERNOR_THRESHOLD=0.35
# BTC breakeven trigger (overnight finding: PF 1.13->1.72)
# Lock in at entry+0.1% once price reaches +0.8% above entry
EXIT_BREAKEVEN_TRIGGER_PCT=0.008
# BTC TP raised from 1.5% to 2.5% (sweep 2026-03-17: tp025 PF=2.344 vs tp015 PF=1.797)
TAKE_PROFIT_PCT=0.025
