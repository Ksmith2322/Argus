# .env.eth — ETH-USD overrides for parallel multi-coin runner
# Base config is inherited from .env via DOTENV_PATH
# Only overrides that differ per coin are listed here.

PRODUCT_ID=ETH-USD
START_CASH_USD=500
MAX_POSITION_USD_PER_SYMBOL=150
MAX_PORTFOLIO_EXPOSURE_USD=150
# ETH breakeven trigger (batch 2: PF 1.014 with be003)
# Lock in at entry+0.1% once price reaches +0.3% above entry
EXIT_BREAKEVEN_TRIGGER_PCT=0.003